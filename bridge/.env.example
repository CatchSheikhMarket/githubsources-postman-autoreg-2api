# postman2api — мост Postman AI (Agent Mode) → OpenAI / Anthropic API.

# access_token Postman. Можно не задавать: при пустых POSTMAN_ACCESS_TOKEN и
# sessions.txt мост сам возьмёт сессию из установленного Postman Desktop
# (<data dir>/storage/userPartitionData.json → auth.access_token).
POSTMAN_ACCESS_TOKEN=

# Несколько аккаунтов: sessions.txt, по одной сессии на строку — access_token
# или "cookie:<postman.sid>" (кука веб-сессии postman.co, F12 → Application →
# Cookies → postman.sid). Запросы идут по кругу; сессия, отбитая 401,
# исключается до перезапуска моста.
SESSIONS_FILE=sessions.txt

# Второй аккаунт без sessions.txt: кука postman.sid веб-сессии postman.co.
# Ротируется вместе с access_token (Desktop/env/sessions.txt).
# POSTMAN_SID_COOKIE=

# Токен, который мост спрашивает у клиентов (Cline/Roo/Claude Code).
AUTH_TOKEN=postman2api

HOST=127.0.0.1
PORT=12005
DEFAULT_MODEL=gpt-5.6-sol
TIMEOUT=300

# ── Апстрим Postman (менять только при необходимости) ──
POSTMAN_API_BASE=https://gateway.postman.com
# Версия Postman для заголовка x-app-version. Если не задана, мост подставит
# lastKnownVersion из установленного Postman Desktop.
POSTMAN_APP_VERSION=12.23.1
POSTMAN_PLATFORM=DESKTOP_LINUX
POSTMAN_PRODUCT=workspace_localmode_v12
POSTMAN_WORKSPACE_ID=proxy-workspace

# Лимит поля input.query у Postman (~10k символов; это не контекст модели).
MAX_QUERY_BYTES=9800

# Хэши инструментов привязаны к версии Postman. При ошибке
# TOOL_VALIDATION_ERROR перехвати свежие значения и раскомментируй:
# POSTMAN_TOOLS_HASH=clienttools-workspace_localmode_v12-desktop-darwin-12.23.1-ui-260811-0231-828d6b3ed37b
# POSTMAN_TERMS_HASH=kbterms-workspace_localmode_v12-desktop-darwin-12.23.1-ui-260811-0231-dbc2c7575e92

# ── Режим клиентских инструментов (tools) ──
# Когда запрос содержит tools, мост переключается на дочерний product
# workspace_tools_sdk_localmode с отдельными хэшами:
POSTMAN_PRODUCT_TOOLS=workspace_tools_sdk_localmode
# POSTMAN_TOOLS_HASH_SDK=clienttools-workspace_tools_sdk_localmode-desktop-darwin-12.23.1-ui-260811-0231-e23d250ee33a
# POSTMAN_TERMS_HASH_SDK=kbterms-workspace_tools_sdk_localmode-desktop-darwin-12.23.1-ui-260811-0231-dbc2c7575e92
